# Environment Configuration for Antisocial

SECRET_KEY=antisocial_super_secret_jwt_and_session_key_2026_red
DATABASE_URL=sqlite:////app/data/antisocial.db
ENVIRONMENT=production

# Server ports
BACKEND_PORT=8000
FRONTEND_PORT=5000
BACKEND_INTERNAL_URL=http://backend:8000

# Security & Uploads
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MAX_UPLOAD_SIZE_MB=100

# Email Confirmation Settings
# When SMTP is disabled, tokens/links will be logged to console and returned in debug headers
SMTP_ENABLED=true
SMTP_SERVER=192.168.2.3
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=noreply@kernelfortress.org
